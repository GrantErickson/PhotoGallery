<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoGallery.App.Pages.OnThisDayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotoGallery.App.Controls">

    <Grid Padding="20,12,8,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="On this day" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,8,0" />
            <Button Click="OnPreviousDay" ToolTipService.ToolTip="Previous day" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE76B;" FontSize="14" />
            </Button>
            <CalendarDatePicker x:Name="DatePicker" VerticalAlignment="Center" DateFormat="{}{month.full} {day.integer}" DateChanged="OnDateChanged" />
            <Button Click="OnNextDay" ToolTipService.ToolTip="Next day" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE76C;" FontSize="14" />
            </Button>
            <Button Content="Today" Click="OnToday" VerticalAlignment="Center" />
            <TextBlock x:Name="SubtitleText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <controls:GalleryView x:Name="Gallery" Grid.Row="1" GroupMode="Day" EmptyMessage="Nothing from this day in other years." />
    </Grid>
</Page>
