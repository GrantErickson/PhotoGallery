<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoGallery.App.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotoGallery.App.Controls"
    xmlns:pages="using:PhotoGallery.App.Pages"
    xmlns:places="using:PhotoGallery.Core.Places">

    <Page.Resources>
        <!-- The track's colour, as on the map (the track variable in map.html), and the stop numbers on it. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TrackBrush" Color="#6250D6" />
                    <SolidColorBrush x:Key="TrackTextBrush" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TrackBrush" Color="#9085E9" />
                    <SolidColorBrush x:Key="TrackTextBrush" Color="#1B1B1B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="20,12,8,0" RowSpacing="8" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Map" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubtitleText" VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Pan and zoom to list the photos in view, or click a number to list just that group." />
            <Button x:Name="ShowAllButton" Content="Show all in view" Visibility="Collapsed" VerticalAlignment="Center" Click="OnShowAll" />
            <DropDownButton Content="Places" VerticalAlignment="Center" ToolTipService.ToolTip="Places you named">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="PlacesMenu" Opening="OnPlacesMenuOpening" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="TrackToggle" VerticalAlignment="Center" Click="OnTrackToggle"
                          ToolTipService.ToolTip="Where photos were taken, in order: the places stopped at and the way between them">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Directions" />
                    <TextBlock Text="Track" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Finding a place by name: on this PC as you type, OpenStreetMap when asked -->
        <AutoSuggestBox x:Name="PlaceSearchBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" QueryIcon="Find"
                        PlaceholderText="Find a place: a town, a park, an address…" TextMemberPath="Name"
                        TextChanged="OnPlaceSearchChanged" QuerySubmitted="OnPlaceSearchSubmitted">
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="places:PlaceHit">
                    <StackPanel Padding="0,4">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <Border Grid.Row="1" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,12">
            <WebView2 x:Name="Map" />
        </Border>
        <TextBlock x:Name="MapError" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Naming a place: a centre (click the map, drag the pin) and a radius. -->
        <Border x:Name="PlacePanel" Grid.Row="1" Visibility="Collapsed" Width="300" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="12,0,0,28" Padding="14,12" CornerRadius="8" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock x:Name="PlacePanelTitle" Text="New place" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="PlacePanelHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Click the map to set the centre, then drag the pin to adjust." />
                <TextBox x:Name="PlaceNameBox" PlaceholderText="Name, e.g. Home or Grandma's" TextChanged="OnPlaceNameChanged" />
                <StackPanel Spacing="0">
                    <TextBlock x:Name="PlaceRadiusText" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="PlaceRadiusSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnPlaceRadiusChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SavePlaceButton" Content="Save" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSavePlace" />
                    <Button Content="Cancel" Click="OnCancelPlace" />
                    <Button x:Name="DeletePlaceButton" Content="Delete" Visibility="Collapsed" Click="OnDeletePlace" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- A track: the photos taken between two dates (or the ones chosen), in order, and the places they were taken. -->
            <StackPanel x:Name="TrackPanel" Visibility="Collapsed" Spacing="8" Margin="0,0,12,0">
                <StackPanel x:Name="TrackDates" Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="TrackFrom" PlaceholderText="From" DateChanged="OnTrackDatesChanged" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="TrackTo" PlaceholderText="To" DateChanged="OnTrackDatesChanged" />
                    <CheckBox x:Name="TrackAreaCheck" Content="Only in this area" Click="OnTrackAreaClick" MinWidth="0" Margin="4,0,0,0"
                              ToolTipService.ToolTip="Only the photos taken in the part of the map in view now" />
                </StackPanel>
                <TextBlock x:Name="TrackSummary" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- People apart (photos in more than one place at once): one group's track at a time. -->
                <ComboBox x:Name="TrackGroupBox" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="OnTrackGroupChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:GroupRow">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ListView x:Name="StopList" MaxHeight="240" SelectionMode="Single" SelectionChanged="OnStopSelected"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:StopRow">
                            <Grid ColumnSpacing="10" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border MinWidth="24" Height="24" Padding="4,0" CornerRadius="12" Background="{ThemeResource TrackBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Number}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TrackTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Count}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <controls:GalleryView x:Name="Gallery" Grid.Row="1" EmptyMessage="No photos in this part of the map." />
        </Grid>
    </Grid>
</Page>
