<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoGallery.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20,12,20,20">
        <StackPanel Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged" MaxColumns="3">
                    <x:String>Dark</x:String>
                    <x:String>Light</x:String>
                    <x:String>Use my Windows setting</x:String>
                </RadioButtons>
                <StackPanel x:Name="ThemeRestart" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Menus and dialogs switch after the app restarts." />
                    <Button Content="Restart now" Click="OnRestart" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Library folders" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Photos and videos in these folders (and their subfolders) are indexed. Files are never modified." />
                <ListView x:Name="RootsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}" Click="OnRemoveRoot" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add folder…" Click="OnAddRoot" />
                    <Button Content="Rescan now" Click="OnRescan" />
                </StackPanel>
                <ToggleSwitch x:Name="ConfirmDeleteSwitch" Header="Ask before deleting photos (they go to the Recycle Bin either way)"
                              Toggled="OnConfirmDeleteToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="OneDrive" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Sign in with the personal Microsoft account that owns your OneDrive to play iPhone Live Photos whose video is only stored in the cloud, and to open items on OneDrive.com. Read-only access." />
                <TextBlock x:Name="AccountText" />
                <TextBlock x:Name="CloudSyncText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SyncButton" Content="Read tags and people now" Click="OnSyncNow" />
                    <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOut" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Live Photos and people" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Newer iPhone Live Photos keep their video only in OneDrive, and the people OneDrive recognised (with the names you gave them there and where their faces are) are only shown on the OneDrive website. Connect once (sign in to OneDrive inside the gallery) and Live Photos play here and People matches OneDrive. The sign-in stays on this PC; the gallery uses it only to download Live Photo videos when you play them and to read people and faces." />
                <TextBlock x:Name="LiveStatusText" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConnectWebButton" Content="Connect OneDrive" Click="OnConnectWeb" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="DisconnectWebButton" Content="Disconnect" Click="OnDisconnectWeb" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Video transcripts" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="What's said in each video is turned into text on this PC (Whisper large-v3-turbo on the graphics card; nothing is uploaded) and shown beside the video when you open it. Spoken words are searchable. The video you open is always done first; the rest of the library can be worked through in the background, newest first." />
                <ToggleSwitch x:Name="TranscribeSwitch" Header="Transcribe all videos in the background" Toggled="OnTranscribeToggled" />
                <TextBlock x:Name="TranscriptStatsText" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Text in photos" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Text in photos and screenshots (signs, receipts, documents, whiteboards) is read on this PC with Windows' built-in OCR, shown under Details and searchable. Screenshots and photos OneDrive filed as text are read first." />
                <ToggleSwitch x:Name="PhotoTextSwitch" Header="Read text in all photos in the background" Toggled="OnPhotoTextToggled" />
                <TextBlock x:Name="PhotoTextStatsText" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Place names" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Names the parks, schools, restaurants, cafés, churches, museums, beaches and other places your photos were taken at, and makes them searchable (“Manito Park”, “restaurant”). The names come from OpenStreetMap: looking them up sends the rough areas (squares of about 5 × 4 km) where your photos were taken to OpenStreetMap's Overpass service, once each. Nothing else is sent. Place data © OpenStreetMap contributors (ODbL)." />
                <ToggleSwitch x:Name="PoiSwitch" Header="Look up place names online" Toggled="OnPoiToggled" />
                <TextBlock x:Name="PoiStatsText" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Similar photos and searching by description" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Every photo and video is compared by what's in it, on this PC with OpenAI's CLIP (ViT-L/14) on the graphics card; nothing is uploaded. The model (about 860 MB) downloads once. Then the viewer can show similar photos, and searches offer photos that look like what you typed." />
                <ToggleSwitch x:Name="SimilarSwitch" Header="Compare all photos in the background" Toggled="OnSimilarToggled" />
                <TextBlock x:Name="SimilarStatsText" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Remote access" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Let other computers on your network browse, search and view this library: in a web browser, or in Photo Gallery on that computer (Another computer, at the bottom of the menu). This PC does the work (searching, decoding photos, fetching Live Photo videos), so it has to be on. Only computers on your local network can connect, only with the passphrase, and the connection is encrypted. They can always look and rate; changing anything else is a separate choice below." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox x:Name="RemotePassphraseBox" Width="300" PlaceholderText="New passphrase (8 characters or more)" KeyDown="OnRemotePassphraseKeyDown" />
                    <Button x:Name="RemotePassphraseButton" Content="Set passphrase" Click="OnSetRemotePassphrase" />
                </StackPanel>
                <TextBlock x:Name="RemotePassphraseText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="RemoteSwitch" Header="Let other computers on my network open this library" Toggled="OnRemoteToggled" />
                <ToggleSwitch x:Name="RemoteChangesSwitch" Header="Let them change things too: edit photos and videos, delete (to this PC's Recycle Bin), tags, albums and people"
                              Toggled="OnRemoteChangesToggled" />
                <NumberBox x:Name="RemotePortBox" Header="Port" Minimum="1024" Maximum="65535" Width="140" HorizontalAlignment="Left"
                           SpinButtonPlacementMode="Hidden" ValueChanged="OnRemotePortChanged" />
                <TextBlock x:Name="RemoteStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Library" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="StatsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="PathsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
