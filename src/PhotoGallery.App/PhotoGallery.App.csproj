<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <RootNamespace>PhotoGallery.App</RootNamespace>
    <AssemblyName>PhotoGallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Made by tools/icons/MakeIcons.cs from the SVGs there. -->
    <ApplicationIcon>Assets\PhotoGallery.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <!-- Speech to text: whisper.cpp, on the GPU through Vulkan (needs only the graphics driver), CPU as fallback. -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoGallery.Core\PhotoGallery.Core.csproj" />
    <!-- Remote access: the HTTPS server other computers on the network connect to (off unless turned on). -->
    <ProjectReference Include="..\PhotoGallery.Remote\PhotoGallery.Remote.csproj" />
    <!-- CLIP runs in its own process (its ONNX Runtime is the DirectML build); built first, copied to .\embedder. -->
    <ProjectReference Include="..\PhotoGallery.Embedder\PhotoGallery.Embedder.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Who's speaking (sherpa-onnx) runs in its own process too (its ONNX Runtime isn't Windows'); copied to .\speakers. -->
    <ProjectReference Include="..\PhotoGallery.Speakers\PhotoGallery.Speakers.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyHelpers" AfterTargets="Build">
    <PropertyGroup>
      <EmbedderOut>..\PhotoGallery.Embedder\bin\$(Configuration)\$(TargetFramework)\win-x64\</EmbedderOut>
      <SpeakersOut>..\PhotoGallery.Speakers\bin\$(Configuration)\$(TargetFramework)\win-x64\</SpeakersOut>
    </PropertyGroup>
    <ItemGroup>
      <EmbedderFiles Include="$(EmbedderOut)**\*" Exclude="$(EmbedderOut)**\*.pdb;$(EmbedderOut)**\*.lib;$(EmbedderOut)**\DirectML.Debug.*" />
      <SpeakersFiles Include="$(SpeakersOut)**\*" Exclude="$(SpeakersOut)**\*.pdb;$(SpeakersOut)**\*.lib" />
    </ItemGroup>
    <Copy SourceFiles="@(EmbedderFiles)" DestinationFiles="@(EmbedderFiles->'$(OutDir)embedder\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SpeakersFiles)" DestinationFiles="@(SpeakersFiles->'$(OutDir)speakers\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
