<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoGallery.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotoGallery.App.Controls"
    xmlns:app="using:PhotoGallery.App"
    Title="Photo Gallery">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: back, menu and the search box (the window's own caption buttons sit to its right) -->
        <TitleBar x:Name="AppTitleBar" Title="Photo Gallery"
                  IsBackButtonVisible="True" IsBackButtonEnabled="False" BackRequested="OnTitleBarBackRequested"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search your photos: people, places, things, text, what was said (Ctrl+E)"
                                QueryIcon="Find" MinWidth="360" MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                GotFocus="OnSearchBoxGotFocus" TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen"
                                QuerySubmitted="OnSearchSubmitted" PreviewKeyDown="OnSearchBoxKeyDown">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="app:SearchSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Query}" />
                                <TextBlock Text="{x:Bind Kind}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Photos" Tag="timeline" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="On this day" Tag="onthisday">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Live Photos" Tag="live">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="People" Tag="people">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tags" Tag="tags">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Folders" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Map" Tag="map">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE707;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Duplicates" Tag="duplicates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Blurry photos" Tag="blurry">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="RemoteNavItem" Content="Another computer" Tag="remote"
                                    ToolTipService.ToolTip="Photos on another computer on your network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" Navigating="OnFrameNavigating" />
        </NavigationView>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="IndexProgress" Grid.Column="1" Width="200" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>

        <!-- Viewer overlay -->
        <controls:ViewerControl x:Name="Viewer" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- Editor overlay (on top of the viewer) -->
        <controls:EditorControl x:Name="Editor" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <controls:VideoEditorControl x:Name="VideoEditor" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
