<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.ViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:PhotoGallery.Core.Data"
    xmlns:app="using:PhotoGallery.App"
    xmlns:controls="using:PhotoGallery.App.Controls"
    IsTabStop="True"
    PreviewKeyDown="OnPreviewKeyDown">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InfoColumn" Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.ColumnSpan="2" Padding="8,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnClose" ToolTipService.ToolTip="Back (Esc)" Style="{StaticResource SubtleButtonStyle}">
                <SymbolIcon Symbol="Back" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button x:Name="LiveButton" Click="OnPlayMotion" Visibility="Collapsed" ToolTipService.ToolTip="Play Live Photo (Space) — then step frames and save one">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="◉ LIVE" FontWeight="SemiBold" />
                        <ProgressRing x:Name="LiveBusy" Width="14" Height="14" IsActive="False" />
                    </StackPanel>
                </Button>
                <Button x:Name="SimilarButton" Click="OnFindSimilar" ToolTipService.ToolTip="Similar photos" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                </Button>
                <Button x:Name="EditButton" Click="OnEdit" ToolTipService.ToolTip="Edit (E)" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                </Button>
                <Button Click="OnDelete" ToolTipService.ToolTip="Delete (Del)" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                </Button>
                <Button Click="OnCopyPath" ToolTipService.ToolTip="Copy full path (Ctrl+Shift+C)" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                </Button>
                <Button Click="OnOpenLocation" ToolTipService.ToolTip="Show in File Explorer" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xED25;" FontSize="16" />
                </Button>
                <Button Click="OnOpenOneDrive" ToolTipService.ToolTip="Open in OneDrive" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE753;" FontSize="16" />
                </Button>
                <ToggleButton x:Name="InfoToggle" IsChecked="True" Click="OnToggleInfo" ToolTipService.ToolTip="Info (I)">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Media -->
        <Grid x:Name="Stage" Grid.Row="1" SizeChanged="OnStageSizeChanged">
            <ScrollViewer
                x:Name="Zoom"
                ZoomMode="Enabled"
                MinZoomFactor="1"
                MaxZoomFactor="10"
                HorizontalScrollMode="Auto"
                VerticalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                DoubleTapped="OnZoomDoubleTapped">
                <!-- The frame is sized to the stage; the image fits and centres inside it, and zoom scales both. -->
                <Grid x:Name="PhotoFrame">
                    <!-- Sized to the fitted picture, so face boxes (fractions of the photo) line up at any zoom. -->
                    <Grid x:Name="PhotoLayer" HorizontalAlignment="Center" VerticalAlignment="Center"
                          PointerMoved="OnPhotoPointerMoved" PointerExited="OnPhotoPointerExited" SizeChanged="OnPhotoLayerSizeChanged">
                        <Image x:Name="Photo" Stretch="Uniform" />
                        <Canvas x:Name="TextMarkLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="FaceLayer">
                            <Border x:Name="FaceBoxOuter" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="#99000000" BorderThickness="1" CornerRadius="6">
                                <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" />
                            </Border>
                            <Border x:Name="FaceLabel" Visibility="Collapsed" Padding="8,3" CornerRadius="4" Background="#CC000000"
                                    PointerEntered="OnFaceLabelPointerEntered" PointerExited="OnFaceLabelPointerExited" Tapped="OnFaceLabelTapped">
                                <TextBlock x:Name="FaceLabelText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <MediaPlayerElement x:Name="Player" Visibility="Collapsed" AreTransportControlsEnabled="True" />
            <!-- The frame "Sharpest frame" found, exactly as Save frame writes it (a paused player can show a neighbour) -->
            <Image x:Name="FramePreview" Visibility="Collapsed" Stretch="Uniform" IsHitTestVisible="False" />

            <!-- Frame tools: shown whenever a video (or Live Photo motion) is on screen -->
            <Border x:Name="FrameBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    Padding="6" CornerRadius="8" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Click="OnPreviousFrame" ToolTipService.ToolTip="Previous frame ( , )" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="FrameTimeText" MinWidth="84" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" Text="0:00.000" />
                    <Button Click="OnNextFrame" ToolTipService.ToolTip="Next frame ( . )" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                    </Button>
                    <Button x:Name="SharpestButton" Click="OnSharpestFrame" Visibility="Collapsed"
                            ToolTipService.ToolTip="Go to the sharpest frame of the Live Photo's video; Save frame then keeps it as a photo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71E;" FontSize="14" />
                            <TextBlock Text="Sharpest frame" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveFrameButton" Click="OnSaveFrame" Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Save this frame as a photo in the same folder (S)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE722;" FontSize="14" />
                            <TextBlock Text="Save frame" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveVideoButton" Click="OnSaveLiveVideo" Visibility="Collapsed"
                            ToolTipService.ToolTip="Save the Live Photo's motion as an MP4 video next to the photo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE714;" FontSize="14" />
                            <TextBlock x:Name="SaveVideoText" Text="Save video" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnEditVideo" ToolTipService.ToolTip="Rotate, trim or remove sound, and save as MP4 (E)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Edit video" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShowPhotoButton" Content="Show photo" Click="OnShowPhoto" Visibility="Collapsed"
                            ToolTipService.ToolTip="Back to the Live Photo's still" />
                </StackPanel>
            </Border>

            <!-- Messages while the viewer covers the status bar -->
            <Border x:Name="Toast" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,110" Padding="14,8" CornerRadius="8" Background="#E6202020">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="640" />
            </Border>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="24" />

            <Button x:Name="PrevButton" Click="OnPrevious" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12"
                    Height="64" Opacity="0.7" ToolTipService.ToolTip="Previous (←)">
                <FontIcon Glyph="&#xE76B;" />
            </Button>
            <Button x:Name="NextButton" Click="OnNext" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"
                    Height="64" Opacity="0.7" ToolTipService.ToolTip="Next (→)">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <!-- Side pane: for videos, the transcript or the details -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="SideTabs" Visibility="Collapsed" Margin="8,2,8,0" SelectionChanged="OnSideTabChanged">
                <SelectorBarItem x:Name="TranscriptTab" Text="Transcript" IsSelected="True" />
                <SelectorBarItem x:Name="DetailsTab" Text="Details" />
            </SelectorBar>

            <Grid x:Name="TranscriptPane" Grid.Row="1" Visibility="Collapsed" Padding="16,8,4,8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="TranscriptStatusText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="TranscriptProgress" Visibility="Collapsed" Maximum="1" />
                    </StackPanel>
                    <Button x:Name="RetryTranscriptButton" Grid.Column="1" Content="Try again" Click="OnRetryTranscript" Visibility="Collapsed" />
                    <Button x:Name="CopyTranscriptButton" Grid.Column="2" Click="OnCopyTranscript" Visibility="Collapsed"
                            ToolTipService.ToolTip="Copy the transcript" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                </Grid>
                <Grid x:Name="TranscriptFindBar" Grid.Row="1" ColumnSpacing="2" Margin="0,0,8,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TranscriptFind" PlaceholderText="Find in transcript (Ctrl+F)" />
                    <TextBlock x:Name="TranscriptFindCount" Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="FindPreviousButton" Grid.Column="2" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Previous (Shift+Enter)">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button x:Name="FindNextButton" Grid.Column="3" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Next (Enter)">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2" Padding="0,0,12,0"
                              PointerWheelChanged="OnTranscriptUserScroll" DirectManipulationStarted="OnTranscriptUserScroll">
                    <ItemsControl x:Name="TranscriptList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:TranscriptLine">
                                <Border Padding="8,6" Margin="-8,0,0,2" CornerRadius="6" Background="{x:Bind Background, Mode=OneWay}">
                                    <StackPanel Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <HyperlinkButton Content="{x:Bind Time}" Padding="0" FontSize="12" Click="OnTranscriptSeek" Tag="{x:Bind}"
                                                             ToolTipService.ToolTip="Play from here" />
                                            <TextBlock Text="{x:Bind Speaker}" Visibility="{x:Bind SpeakerVisibility}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" DataContextChanged="OnTranscriptTextDataContextChanged" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        <Grid x:Name="InfoPane" Grid.Row="1" SizeChanged="OnInfoPaneSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <ScrollViewer x:Name="DetailsScroll" Padding="16,8,16,16">
            <StackPanel Spacing="14">
                <RatingControl x:Name="Rating" HorizontalAlignment="Left" IsClearEnabled="True" ValueChanged="OnRatingChanged" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Taken" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TakenText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="File" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FileText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="CameraPanel" Spacing="2">
                    <TextBlock Text="Camera" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CameraText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="LocationPanel" Spacing="2">
                    <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="PlaceLink" Padding="0" Click="OnPlaceLinkClick" Visibility="Collapsed"
                                     ToolTipService.ToolTip="Show the area on the map" />
                    <HyperlinkButton x:Name="LocationLink" Padding="0" FontSize="12" Click="OnOpenMap"
                                     ToolTipService.ToolTip="Show this photo on the map" />
                    <HyperlinkButton x:Name="NamePlaceLink" Padding="0" FontSize="12" Content="Name this place…" Click="OnNamePlace"
                                     ToolTipService.ToolTip="Name the place (e.g. Home) with a radius; photos taken there get the name" />
                </StackPanel>
                <StackPanel x:Name="EditedPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Unsaved edits" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#C75000" />
                    <TextBlock x:Name="EditedText" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Shown here, but not written to any file yet." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="Save…" Padding="0" Click="OnEdit" />
                        <HyperlinkButton Content="Revert to original" Padding="0" Click="OnRevertEdits" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="MotionPanel" Spacing="2">
                    <TextBlock Text="Motion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MotionText" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="PeoplePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="People" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="PeopleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:FaceRow">
                                <HyperlinkButton Content="{x:Bind DisplayName}" Padding="0" Margin="0,0,0,2" Click="OnPersonClick" Tag="{x:Bind}"
                                                 PointerEntered="OnPersonPointerEntered" PointerExited="OnPersonPointerExited" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Tags" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="TagList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:TagRow">
                                <Grid ColumnSpacing="4" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HyperlinkButton Content="{x:Bind Name}" Padding="0" Click="OnTagClick" Tag="{x:Bind}"
                                                     ToolTipService.ToolTip="{x:Bind app:Format.TagSource(Source)}" />
                                    <Button Grid.Column="1" Tag="{x:Bind Id}" Click="OnRemoveTag" Style="{StaticResource SubtleButtonStyle}"
                                            Visibility="{x:Bind app:Format.Visible(IsUserTag)}"
                                            Padding="4" ToolTipService.ToolTip="Remove tag">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <AutoSuggestBox x:Name="TagBox" PlaceholderText="Add a tag" TextChanged="OnTagBoxTextChanged" QuerySubmitted="OnTagSubmitted">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Add" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Albums" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AlbumsText" TextWrapping="Wrap" />
                    <DropDownButton Content="Add to album">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="AlbumMenu" Opening="OnAlbumMenuOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

            <!-- Text read from the photo: fills the space below the details and scrolls on its own. -->
            <Grid x:Name="PhotoTextPanel" Grid.Row="1" Visibility="Collapsed" Padding="16,10,4,8" RowSpacing="6"
                  BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBlock x:Name="PhotoTextTitle" Text="Text in photo" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button HorizontalAlignment="Right" Padding="6,2" Click="OnCopyPhotoText" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Copy the text">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    </Button>
                </Grid>
                <Grid x:Name="PhotoTextFindBar" Grid.Row="1" ColumnSpacing="2" Margin="0,0,12,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PhotoTextFind" PlaceholderText="Find in the text (Ctrl+F)" />
                    <TextBlock x:Name="PhotoTextFindCount" Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="PhotoTextPrevious" Grid.Column="2" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Previous (Shift+Enter)">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button x:Name="PhotoTextNext" Grid.Column="3" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Next (Enter)">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="PhotoTextScroll" Grid.Row="2" Padding="0,0,12,0">
                    <ItemsControl x:Name="PhotoTextList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:PhotoTextLine">
                                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,2"
                                           DataContextChanged="OnPhotoTextLineDataContextChanged" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
