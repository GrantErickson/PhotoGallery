<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.GalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PhotoGallery.App"
    xmlns:data="using:PhotoGallery.Core.Data"
    xmlns:pages="using:PhotoGallery.App.Pages">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Filter bar, or selection commands while items are selected -->
        <Grid Grid.ColumnSpan="2" Padding="0,0,8,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="KindBox" SelectedIndex="0" MinWidth="120" SelectionChanged="OnFilterChanged">
                    <x:String>All media</x:String>
                    <x:String>Photos</x:String>
                    <x:String>Videos</x:String>
                </ComboBox>
                <ComboBox x:Name="RatingBox" SelectedIndex="0" MinWidth="110" SelectionChanged="OnFilterChanged">
                    <x:String>Any rating</x:String>
                    <x:String>★ 1+</x:String>
                    <x:String>★ 2+</x:String>
                    <x:String>★ 3+</x:String>
                    <x:String>★ 4+</x:String>
                    <x:String>★ 5</x:String>
                </ComboBox>
                <ToggleButton x:Name="MotionToggle" Click="OnFilterChanged" ToolTipService.ToolTip="Only Live Photos and motion photos">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="◉ Live" />
                    </StackPanel>
                </ToggleButton>
                <ComboBox x:Name="ScreenshotBox" SelectedIndex="0" MinWidth="150" SelectionChanged="OnFilterChanged"
                          ToolTipService.ToolTip="Screenshots and utility shots: photos of receipts, documents, screens, boxes, tickets, whiteboards, instructions…">
                    <x:String>No utility shots</x:String>
                    <x:String>With utility shots</x:String>
                    <x:String>Only utility shots</x:String>
                </ComboBox>
                <DropDownButton x:Name="PeopleButton" ToolTipService.ToolTip="Only photos with these people in them">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE716;" FontSize="14" />
                        <TextBlock x:Name="PeopleText" Text="Anyone" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="PeopleFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnPeopleFlyoutOpening">
                            <StackPanel Width="300" Spacing="8">
                                <TextBlock Text="Photos with…" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="PeopleSearch" PlaceholderText="Find a person" TextChanged="OnPeopleSearchChanged" />
                                <ListView x:Name="PeopleList" SelectionMode="Multiple" MaxHeight="420" IsItemClickEnabled="False"
                                          SelectionChanged="OnPeopleSelectionChanged" ContainerContentChanging="OnPeopleContainerChanging">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="pages:PersonTile">
                                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind PhotoCountText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Pick more than one for photos with all of them." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Anyone" Click="OnClearPeople" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <CommandBar x:Name="SelectionBar" Visibility="Collapsed" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
                <AppBarButton x:Name="AddToAlbumButton" Icon="Pictures" Label="Add to album">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="AlbumMenu" Opening="OnAlbumMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="RemoveFromAlbumButton" Icon="Remove" Label="Remove from album" Click="OnRemoveFromAlbum" Visibility="Collapsed" />
                <AppBarButton Icon="Tag" Label="Tag">
                    <AppBarButton.Flyout>
                        <Flyout x:Name="TagFlyout">
                            <StackPanel Spacing="8" Width="240">
                                <TextBlock Text="Add a tag to the selection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <AutoSuggestBox x:Name="TagBox" PlaceholderText="Tag name" TextChanged="OnTagBoxTextChanged" QuerySubmitted="OnTagSubmitted" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Favorite" Label="Rate">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="★★★★★" Tag="5" Click="OnRateSelection" />
                            <MenuFlyoutItem Text="★★★★" Tag="4" Click="OnRateSelection" />
                            <MenuFlyoutItem Text="★★★" Tag="3" Click="OnRateSelection" />
                            <MenuFlyoutItem Text="★★" Tag="2" Click="OnRateSelection" />
                            <MenuFlyoutItem Text="★" Tag="1" Click="OnRateSelection" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Clear rating" Tag="0" Click="OnRateSelection" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Document" Label="Utility shots" ToolTipService.ToolTip="Screenshots and photos of receipts, documents, screens… are left out of the timeline">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Utility shots: leave out of the timeline" Tag="1" Click="OnMarkUtility" />
                            <MenuFlyoutItem Text="Not utility shots: show in the timeline" Tag="0" Click="OnMarkUtility" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Let the app decide" Tag="" Click="OnMarkUtility" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="Delete" Click="OnDeleteSelection" ToolTipService.ToolTip="Move to the Recycle Bin (Del)" />
                <AppBarButton Icon="Copy" Label="Copy paths" Click="OnCopySelectedPaths" />
                <AppBarButton Icon="Clear" Label="Clear selection" Click="OnClearSelection" />
            </CommandBar>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="CurrentDate" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Slider x:Name="SizeSlider" Width="130" Minimum="100" Maximum="480" StepFrequency="20" ValueChanged="OnTileSizeChanged"
                        ToolTipService.ToolTip="Thumbnail size" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <GridView
            x:Name="Grid"
            Grid.Row="1"
            SelectionMode="Extended"
            IsItemClickEnabled="False"
            ShowsScrollingPlaceholders="False"
            ContainerContentChanging="OnContainerContentChanging"
            SelectionChanged="OnSelectionChanged"
            PreviewKeyDown="OnGridPreviewKeyDown"
            DragItemsCompleted="OnDragItemsCompleted">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="184" CacheLength="2" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="app:MonthGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="data:MediaSummary">
                    <!-- Children order matters to code-behind: [0] picture (an image brush, shifted to show faces) ... [^2] day accent bar, [^1] selection overlay. -->
                    <Grid Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="4" DoubleTapped="OnTileDoubleTapped" RightTapped="OnTileRightTapped">
                        <Border />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Visibility="{x:Bind app:Format.Visible(StartsDay)}" Padding="8,2" CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="#E6FFFFFF" BorderThickness="1">
                                <TextBlock Text="{x:Bind app:Format.Day(DateTaken)}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border Visibility="{x:Bind app:Format.HasMotion(Motion)}" Width="18" Height="18" CornerRadius="9" Background="#99000000"
                                    ToolTipService.ToolTip="Live Photo">
                                <TextBlock Text="◉" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border Visibility="{x:Bind app:Format.Visible(IsDerived)}" Padding="4,2" CornerRadius="3" Background="#99000000"
                                    ToolTipService.ToolTip="Edited copy of another photo">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="White" />
                            </Border>
                            <Border Visibility="{x:Bind app:Format.Visible(IsEdited)}" Padding="4,2" CornerRadius="3" Background="#CCC75000"
                                    ToolTipService.ToolTip="Has edits kept in the gallery (not written to a file yet)">
                                <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="White" />
                            </Border>
                            <Button Visibility="{x:Bind app:Format.IsVideo(Kind)}" Padding="6,2" MinHeight="0" CornerRadius="3" Background="#99000000"
                                    BorderThickness="0" Click="OnTilePlayClick" ToolTipService.ToolTip="Play a preview here">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White" />
                                    <TextBlock Text="{x:Bind app:Format.Duration(DurationMs)}" FontSize="11" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Visibility="{x:Bind app:Format.HasRating(Rating)}" Text="{x:Bind app:Format.Stars(Rating)}"
                                   Margin="6" FontSize="12" Foreground="Gold" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Border Visibility="{x:Bind app:Format.Visible(StartsDay)}" Width="4" HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Grid Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="4" CornerRadius="4"
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                            <Border Width="24" Height="24" CornerRadius="12" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="White" BorderThickness="2">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

        <!-- Timeline jump list -->
        <ListView
            x:Name="JumpList"
            Grid.Row="1"
            Grid.Column="1"
            Width="112"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnJumpClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="app:JumpEntry">
                    <TextBlock Text="{x:Bind Label}" FontSize="{x:Bind FontSize}" FontWeight="{x:Bind Weight, Mode=OneWay}"
                               Foreground="{x:Bind Foreground, Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
