<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.EditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.Resources>
        <Style x:Key="CropHandle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#99000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.ColumnSpan="2" Padding="8,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnCancel" ToolTipService.ToolTip="Cancel (Esc)" Style="{StaticResource SubtleButtonStyle}">
                <SymbolIcon Symbol="Cancel" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Edit" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="FileText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Reset" Click="OnResetAll" ToolTipService.ToolTip="Undo all changes in this session" />
                <Button Content="Keep edits in gallery" Click="OnSave"
                        ToolTipService.ToolTip="Remember these edits in the gallery only. No file is written; the photo shows an orange pencil until you save a copy or overwrite." />
                <Button x:Name="OverwriteButton" Content="Overwrite original…" Click="OnOverwrite"
                        ToolTipService.ToolTip="Replace the original file with the edited photo (the original goes to the Recycle Bin)" />
                <Button Content="Save as copy" Click="OnSaveCopy" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Write a new edited file next to the original (Ctrl+S)" />
            </StackPanel>
        </Grid>

        <!-- Stage: edited image with the crop box on top -->
        <Grid x:Name="Stage" Grid.Row="1" Margin="24" SizeChanged="OnStageSizeChanged">
            <canvas:CanvasControl x:Name="EditCanvas" Draw="OnDraw" ClearColor="Transparent" />
            <Canvas x:Name="Overlay">
                <Path x:Name="Shade" Fill="#99000000" IsHitTestVisible="False" />
                <Border x:Name="CropBox" BorderBrush="White" BorderThickness="2" Background="Transparent"
                        ManipulationMode="TranslateX,TranslateY" ManipulationDelta="OnCropBoxManipulationDelta">
                    <Grid IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="#66FFFFFF" BorderThickness="1,0" />
                        <Border Grid.ColumnSpan="3" Grid.Row="1" BorderBrush="#66FFFFFF" BorderThickness="0,1" />
                    </Grid>
                </Border>
                <Border x:Name="HandleTopLeft" Tag="TL" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleTopRight" Tag="TR" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleBottomLeft" Tag="BL" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleBottomRight" Tag="BR" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleTop" Tag="T" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleBottom" Tag="B" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleLeft" Tag="L" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
                <Border x:Name="HandleRight" Tag="R" Style="{StaticResource CropHandle}" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleReleased" />
            </Canvas>
            <ProgressRing x:Name="Busy" IsActive="True" Width="40" Height="40" />
        </Grid>

        <!-- Tools -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="16,8,16,16"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Rotate and flip" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRotateLeft" ToolTipService.ToolTip="Rotate left ([)">
                            <FontIcon Glyph="&#xE7AD;" />
                        </Button>
                        <Button Click="OnRotateRight" ToolTipService.ToolTip="Rotate right (])">
                            <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Click="OnFlip" ToolTipService.ToolTip="Flip horizontally">
                            <FontIcon Glyph="&#xE8AB;" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Crop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="AspectBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnAspectChanged">
                        <x:String>Free</x:String>
                        <x:String>Original</x:String>
                        <x:String>Square</x:String>
                        <x:String>4:3</x:String>
                        <x:String>3:2</x:String>
                        <x:String>16:9</x:String>
                        <x:String>9:16</x:String>
                    </ComboBox>
                    <Button Content="Reset crop" Click="OnResetCrop" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Light" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Slider x:Name="ExposureSlider" Header="Exposure" Minimum="-2" Maximum="2" StepFrequency="0.05" ValueChanged="OnLightChanged" />
                    <Slider x:Name="BrightnessSlider" Header="Brightness" Minimum="-1" Maximum="1" StepFrequency="0.02" ValueChanged="OnLightChanged" />
                    <Slider x:Name="ContrastSlider" Header="Contrast" Minimum="-1" Maximum="1" StepFrequency="0.02" ValueChanged="OnLightChanged" />
                    <Button Content="Reset light" Click="OnResetLight" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Saving" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run FontWeight="SemiBold">Save as copy</Run> writes a new file next to the original (<Run x:Name="CopyNameRun" />).
                        <LineBreak /><Run FontWeight="SemiBold">Overwrite original</Run> replaces the file; the old version goes to the Recycle Bin.
                        <LineBreak /><Run FontWeight="SemiBold">Keep edits in gallery</Run> writes no file: the edits are only remembered here and shown with an orange pencil.
                    </TextBlock>
                    <HyperlinkButton Content="Export to another folder…" Padding="0" Click="OnExport" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
