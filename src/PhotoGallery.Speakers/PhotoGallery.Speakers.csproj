<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Who's speaking in a video, for Photo Gallery's transcripts: sherpa-onnx speaker diarization (pyannote segmentation +
    NeMo TitaNet embeddings, on the CPU). A separate process because sherpa-onnx must use the ONNX Runtime it ships
    with, and Windows has its own, older one that it loads into the app for face detection (Windows.Media.FaceAnalysis,
    since the November 2026 update). Both are "onnxruntime.dll", and a process gets whichever loaded first: sherpa-onnx
    on Windows' copy crashed the app. The app copies this project's output into its own "speakers" folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <RootNamespace>PhotoGallery.Speakers</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>
</Project>
